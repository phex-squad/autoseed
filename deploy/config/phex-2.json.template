{
  "server": {
    "id": 2,
    "host": "${SQUAD_HOST}",
    "queryPort": "${PHEX_2_QUERY_PORT}",
    "rconPort": "${PHEX_2_RCON_PORT}",
    "rconPassword": "${PHEX_2_RCON_PASSWORD}",
    "logReaderMode": "tail",
    "logDir": "${PHEX_2_LOG_DIR}",
    "adminLists": []
  },
  "connectors": {},
  "plugins": [
    {
      "plugin": "AutoseedExporter",
      "enabled": true,
      "listenHost": "127.0.0.1",
      "listenPort": 32082,
      "pathPrefix": "/v1/autoseed",
      "serverId": 2,
      "serverCode": "phex-2",
      "serverName": "[RU][#2] PHEX | ФЕНИКС | discord.gg/phex",
      "isSeedCandidate": true,
      "squadbrowserApiKey": "${SQUADBROWSER_API_KEY}",
      "corsOrigins": [
        "https://phex-squad.github.io"
      ],
      "staleAfterMs": 90000,
      "rateLimitWindowMs": 60000,
      "rateLimitMaxRequests": 120,
      "eventStreamMaxConnectionsPerIp": 4
    }
  ],
  "logger": {
    "verboseness": {
      "SquadServer": 1,
      "LogParser": 1,
      "RCON": 1,
      "AutoseedExporter": 1
    },
    "colors": {
      "SquadServer": "yellowBright",
      "SquadServerFactory": "yellowBright",
      "LogParser": "blueBright",
      "RCON": "redBright"
    }
  }
}

