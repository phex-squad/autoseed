# Включить внутрь HTTPS server-блока настоящего домена экспортёра.
# Сам Nginx и сертификат настраивает владелец хоста.

location ^~ /phex-1/v1/autoseed/ {
    proxy_pass http://127.0.0.1:32081/v1/autoseed/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 65s;
}

location ^~ /phex-2/v1/autoseed/ {
    proxy_pass http://127.0.0.1:32082/v1/autoseed/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 65s;
}

